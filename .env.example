# ============================================
# CARECONNECT-HUB - CONFIGURATION ENVIRONNEMENT
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs
# NE JAMAIS COMMITER le fichier .env !
# ============================================

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Récupérez ces valeurs depuis votre dashboard Supabase :
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project ID (visible dans l'URL du dashboard)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Anon/Public Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Supabase URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ============================================
# OPTIONNEL - CONFIGURATION AVANCÉE
# ============================================

# Mode debug (ne pas activer en production)
# VITE_DEBUG_MODE="false"

# URL de l'API backend (si différent de Supabase)
# VITE_API_URL="https://api.your-domain.com"

# ============================================
# NOTES DE SÉCURITÉ
# ============================================
# 1. Les clés VITE_* sont exposées côté client
# 2. Utilisez les Row Level Security (RLS) de Supabase
# 3. Ne stockez jamais la Service Role Key côté client
# 4. Activez l'authentification pour les données sensibles
